{
  "name": "factory-management-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run --exclude '**/*.db.test.ts'",
    "labels:reset": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/reset-labels.ts",
    "access:allow": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/allow-email.ts",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:55322/postgres} vitest run lib/db"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "barcode-detector": "3.0.5",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.2.5",
    "fflate": "0.8.2",
    "html-to-image": "1.11.13",
    "next": "16.4.0",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.4.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5",
    "vitest": "4.0.8",
    "zxing-wasm": "2.2.0"
  }
}
