# Supabase project settings → API Keys. Copy to .env.local.
# On Vercel, connecting the Supabase integration sets these for you (it may
# name the key NEXT_PUBLIC_SUPABASE_ANON_KEY and the database POSTGRES_URL;
# the app reads those too). SITE_URL falls back to the Vercel production domain.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Never prefix secret / service_role keys with NEXT_PUBLIC_.

# Server only, NEVER NEXT_PUBLIC_. Lets admins make accounts and reset
# passwords (People and access). Supabase → Project Settings → API Keys →
# secret key. The Vercel integration sets SUPABASE_SERVICE_ROLE_KEY, which
# the app reads too.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Server only. Supabase dashboard → Connect → ORMs → Drizzle.
# Use the transaction pooler (port 6543) for the app.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# Server only. The app's public address, used in sign-up and password-reset
# emails. Required in production; locally it falls back to the browser's origin.
SITE_URL=http://localhost:3001
